{
  "name": "ai-chat-web",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "./dist",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/login/",
      "destination": "/login.html"
    },
    {
      "source": "/share/*",
      "destination": "/share.html"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ]
}